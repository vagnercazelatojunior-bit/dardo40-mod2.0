type: ItemTurret
name: Silo Dardo-40
description: "Silo balístico de longo alcance. Dispara ogivas nucleares pesadas calibradas para interceptar alvos terrestres e hordas aéreas na dificuldade Erradicação."
size: 5
health: 9000
range: 6500
reload: 1500
shootSound: explosionbig
shake: 20
category: turret

// Sistema de Fluidos para Resfriamento Avançado (Trítio garante 4.95x)
hasLiquids: true
coolantMultiplier: 1.5
consumes: {
  coolant: {
    amount: 0.5
  }
}

ammoTypes: {
  // 🔮 MUNIÇÃO 1: TÓRIO (Ogiva Antiaérea / Defesa de Área)
  thorium: {
    type: ArtilleryBulletType
    damage: 25000
    splashDamage: 18000
    splashDamageRadius: 450
    speed: 6
    lifetime: 1084
    hitShake: 30
    status: blasted
    
    // Força o míssil a colidir e explodir direto nos aviões e chefes voadores
    collidesAir: true
    flakInterval: 20
    
    despawnEffect: reactorExplosion
    hitEffect: massiveExplosion
    shootEffect: shootBigSmoke
    
    frontColor: "f9a3f9"
    backColor: "cb7fcb"
    width: 20
    height: 28
    shrinkY: 0
  }

  // ☢️ MUNIÇÃO 2: PLUTÔNIO (Ogiva Apocalíptica de Fragmentação - Insta-Kill)
  // Nota: se o jogo não achar o item, mude 'plutonio' para 'id-do-seu-outro-mod-plutonio'
  plutonio: {
    type: ArtilleryBulletType
    damage: 95000         // Dano massivo para quebrar escudos de Tier 5 e Antubras
    splashDamage: 80000   // Destruição de área devastadora
    splashDamageRadius: 750 // Raio de explosão gigante (pega quase a tela inteira)
    speed: 6
    lifetime: 1084
    hitShake: 60
    status: blasted
    
    // Detonação em pleno ar contra alvos voadores
    collidesAir: true
    
    despawnEffect: impactReactorExplosion
    hitEffect: reactorExplosion
    shootEffect: massiveExplosion
    
    frontColor: "42ff42"
    backColor: "11aa11"
    width: 28
    height: 38
    shrinkY: 0

    // SISTEMA DE FRAGMENTAÇÃO ANTIAÉREA DA V8
    // Cospe 15 submísseis teleguiados em todas as direções para limpar o resto da horda
    fragBullets: 15
    fragVelocityMin: 0.5
    fragVelocityMax: 1.5
    fragBullet: {
      type: MissileBulletType
      damage: 1500
      splashDamage: 800
      splashDamageRadius: 80
      speed: 5
      lifetime: 40
      homingPower: 0.2
      homingRange: 200
      collidesAir: true
      frontColor: "a3ffa3"
      backColor: "42ff42"
    }
  }
}

requirements: [
  copper/1500
  lead/1000
  thorium/500
  silicon/400
]
research: thorium
